# Chép thành .env rồi điền. KHÔNG commit .env.

# paper | live — live còn cần thêm cờ --live khi chạy
TRADING_MODE=paper

# DNSE Open API V2 (LightSpeed V2) — lấy tại developers.dnse.com.vn; ký HMAC mọi request
DNSE_API_KEY=
DNSE_API_SECRET=
# Số tiểu khoản PHÁI SINH (GET /accounts → derivativeAccount=true; scripts/dnse_trading_probe.py in ra)
DNSE_ACCOUNT_NO=
# OTP email của DNSE được NHẬP TAY: bot nhắn Telegram, bạn trả lời /otp <mã> (OTP sống ~2 phút)

# SSI FastConnect V3 (ssi-sdk 3.x) — lấy tại developers.ssi.com.vn
SSI_CLIENT_ID=
SSI_API_KEY=
SSI_API_SECRET=
# đường dẫn file chứa private key RSA (XML base64) tải từ developers.ssi.com.vn — để NGOÀI repo
SSI_PRIVATE_KEY_PATH=
# tài khoản phái sinh (đuôi 8). OTP SSI nhập tay qua Telegram: /otp ssi <mã>
SSI_ACCOUNT=

# TCBS (tắt mặc định)
TCBS_API_KEY=

# Telegram kênh trading (bot + chat riêng, tách khỏi brief của dashboard)
TELEGRAM_TRADING_BOT_TOKEN=
TELEGRAM_TRADING_CHAT_ID=
