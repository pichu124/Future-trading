# Chép thành .env rồi điền. KHÔNG commit .env.

# paper | live — live còn cần thêm cờ --live khi chạy
TRADING_MODE=paper

# DNSE Open API V2 (LightSpeed V2) — lấy tại developers.dnse.com.vn; ký HMAC mọi request
DNSE_API_KEY=
DNSE_API_SECRET=
# Hộp Gmail riêng nhận emailOTP của DNSE (OTP sống ~2 phút)
DNSE_OTP_EMAIL=

# SSI FastConnect V3 (ssi-sdk 3.x) — lấy tại developers.ssi.com.vn
SSI_CLIENT_ID=
SSI_API_KEY=
SSI_API_SECRET=
SSI_PRIVATE_KEY_PATH=
# tài khoản phái sinh (đuôi 8)
SSI_ACCOUNT=

# TCBS (tắt mặc định)
TCBS_API_KEY=

# Telegram kênh trading (bot + chat riêng, tách khỏi brief của dashboard)
TELEGRAM_TRADING_BOT_TOKEN=
TELEGRAM_TRADING_CHAT_ID=
